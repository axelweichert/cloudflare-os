{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // PRODUCTION config for the live `cloudflareos-backend` worker in the Weichert.at account
  // (6b9b3fa0e9f6be87faf7ca1b212641a3). Committed single source of truth for the prod backend's
  // full binding set, mirroring what OWL-1626/1644 did for the router (wrangler.jsonc at repo
  // root). The upstream ships a gadgets-internal `generate-wrangler-prod.js` that fabricates this
  // at deploy time; that script is not in this fork, so prod backend deploys had been done by
  // hand-assembling bindings (fragile — see OWL-1613 "Binding-Clobber-Falle"). This file replaces
  // that: `wrangler deploy -c wrangler.prod.jsonc --keep-vars` reproduces the live binding set.
  //
  // WORKERS BUILDS DEPLOY COMMAND (OWL-1668) — the Git-connected Workers Builds project for the
  // backend MUST run exactly:
  //     npx wrangler deploy -c packages/workshop-backend/wrangler.prod.jsonc --keep-vars
  // `--keep-vars` is NOT optional: this config intentionally omits the 7 plain_text vars (their
  // values are instance-state, not committed), and a plain `wrangler deploy` treats config as the
  // complete var set and WIPES them (breaking BASE_URL etc. — the OWL-1600 localhost regression).
  // Secrets are never touched by deploy. There is no config-file equivalent of --keep-vars, so this
  // lives in the WB project's deploy command (a CIO/Board plumbing setting).
  //
  // ADMINS (OWL-1670) is the ONE exception: it IS committed below (the admin allowlist is not
  // sensitive — just CF Access emails). It lived only as a live-injected var and drifted to the
  // stale von-Busch identity, hiding the admin area from the board (OWL-1667/1669/1670). Committing
  // it as SoT means every deploy re-applies the correct value; with --keep-vars, config vars are
  // still applied (only vars ABSENT from config are preserved), so ADMINS can never drift again.
  //
  // Binding NAMES and service TARGETS are transcribed verbatim from the live worker settings
  // (GET /workers/scripts/cloudflareos-backend/settings) so a deploy cannot drop a binding.
  //
  // Dev is a separate base: wrangler.dev.jsonc (workshop-backend) + run-dev-server.ts. Never use
  // this file for dev.
  "name": "cloudflareos-backend",
  "account_id": "6b9b3fa0e9f6be87faf7ca1b212641a3",
  "main": ".wrangler/validate/src/server.ts",
  // Generate the fork's bundled format blueprints before the worker build. `src/generated/
  // format-blueprints.ts` is gitignored, so a fresh Workers Builds checkout has no copy; without
  // this step the capnweb-validate build of server.ts (which imports that module) fails. Baking
  // FORMAT_BLUEPRINTS_DIR in here means a bare `wrangler deploy` reproduces the full blueprint set
  // with no manual pre-step (was the manual half of the OWL-1656 deploy recipe).
  // NOTE (OWL-1665 coupling): if vonbusch/ is renamed to owlos/, update this path.
  "build": {
    "command": "FORMAT_BLUEPRINTS_DIR=../../vonbusch/format-blueprints node scripts/build-format-blueprints.mjs && pnpm run build:worker",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "enhanced_error_serialization",
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],

  // Admin allowlist (CF Access emails). Committed SoT — see header note (OWL-1670).
  "vars": {
    "ADMINS": ["axel@weichert.at"]
  },

  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "WORKERS_AI" },

  // Match the committed dev migrations exactly. v0-v2 are already applied to the live worker, so a
  // deploy carrying the same tags runs no migration and leaves DO state (UserDurableObject,
  // OverseerDurableObject, AdminSettings, PendingLogin) untouched.
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserDurableObject", "OverseerDurableObject"] },
    { "tag": "v1", "new_sqlite_classes": ["AdminSettings"] },
    { "tag": "v2", "new_sqlite_classes": ["PendingLogin"] }
  ],

  // Live namespace/bucket IDs (not the dev preview_id aliases).
  "kv_namespaces": [
    { "binding": "BLUEPRINTS", "id": "b2400e8ff63245b292cf0fd8fc588c58" },
    { "binding": "AVATARS", "id": "7d88ce067df840af91d07af60fec8ebf" }
  ],
  "r2_buckets": [
    { "binding": "BLUEPRINT_CONTENT", "bucket_name": "cloudflareos-blueprint-content" }
  ],
  "worker_loaders": [
    { "binding": "LOADER" }
  ],

  // GATEKEEPER_* services MUST carry `entrypoint: "GatekeeperVendor"` — the backend calls each
  // gatekeeper's GatekeeperVendor RPC entrypoint (describe/getSupportedResources), NOT its default
  // export. Omitting it routes the RPC to the default export and throws `The RPC receiver does not
  // implement the method "describe"` for every vendor whose default export isn't the
  // GatekeeperVendor class — the OWL-1661 live outage (VERBUNDEN collapsed 14 -> 1). Same shape
  // run-dev-server.ts (dev) generates. gatekeeper-context additionally needs its sharingDomain prop.
  "services": [
    { "binding": "GATEKEEPER_CLOUDFLARE", "service": "cloudflareos-gk-cloudflare", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_CONFLUENCE", "service": "cloudflareos-gk-confluence", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_CONTEXT", "service": "cloudflareos-gk-context", "entrypoint": "GatekeeperVendor", "props": { "sharingDomain": "https://cloudflareos.weichert.at" } },
    { "binding": "GATEKEEPER_EMAIL", "service": "cloudflareos-gk-email", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_GITHUB", "service": "cloudflareos-gk-github", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_GOOGLE", "service": "cloudflareos-gk-google", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_HOMEASSISTANT", "service": "cloudflareos-gk-homeassistant", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_LINEAR", "service": "cloudflareos-gk-linear", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_MCP", "service": "cloudflareos-gk-mcp", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_MCP_PORTAL", "service": "cloudflareos-gk-mcp-portal", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_NOTION", "service": "cloudflareos-gk-notion", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_OWLOS", "service": "cloudflareos-gk-owlos", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SCHEDULER", "service": "cloudflareos-gk-scheduler", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SLACK", "service": "cloudflareos-gk-slack", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SPOTIFY", "service": "cloudflareos-gk-spotify", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SUPABASE", "service": "cloudflareos-gk-supabase", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_UNIFI", "service": "cloudflareos-gk-unifi", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_ZOOMINFO", "service": "cloudflareos-gk-zoominfo", "entrypoint": "GatekeeperVendor" }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.5 }
  }
}
