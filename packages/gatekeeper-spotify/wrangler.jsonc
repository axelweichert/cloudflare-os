{
  "name": "gatekeeper-spotify",
  "main": ".wrangler/validate/src/spotify.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  // Prod: oeffentliche Origin des NFR-OS-Shell-Routers (cloudflareos.vonbusch.app).
  // Ohne diese Var faellt der Gatekeeper auf http://localhost:8787 zurueck und der
  // Connect-/OAuth-Link zeigt ins Leere (VON-2205).
  "vars": {
    "BASE_URL": "https://cloudflareos.vonbusch.app/gatekeeper/spotify"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "SpotifyGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
