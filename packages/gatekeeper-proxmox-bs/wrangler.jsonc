{
  "name": "cloudflareos-gk-proxmox-bs",
  "account_id": "6d2a1d5945f8b63047a1d59a9f94de21",
  "main": ".wrangler/validate/src/proxmox.ts",
  "vars": {
    "BASE_URL": "https://cloudflareos.weichert.at/gatekeeper/proxmox-bs"
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "ProxmoxGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
