{
  "name": "cloudflareos-gk-owlos",
  "account_id": "6b9b3fa0e9f6be87faf7ca1b212641a3",
  "main": ".wrangler/validate/src/owlos.ts",
  "vars": {
    "BASE_URL": "https://cloudflareos.weichert.at/gatekeeper/owlos"
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "OwlosGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
