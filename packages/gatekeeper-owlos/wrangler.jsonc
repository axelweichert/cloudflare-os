{
  // Base/dev name matches the package directory, per the convention every other gatekeeper
  // follows (scripts/preview/staging-config.ts enforces name === dir). The prod worker name
  // (cloudflareos-gk-owlos, bound as GATEKEEPER_OWLOS in the root wrangler.jsonc) and account
  // are supplied at deploy time, like the other cloudflareos-gk-* workers — not committed here.
  "name": "gatekeeper-owlos",
  "main": ".wrangler/validate/src/owlos.ts",
  "vars": {
    "BASE_URL": "https://cloudflareos.weichert.at/gatekeeper/owlos"
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "OwlosGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
